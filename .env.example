# 复制为 .env（与可执行文件同目录），或作为 systemd 的 EnvironmentFile。
# 已存在的真实环境变量优先级更高，.env 不会覆盖它们。

# ── 监听 ──────────────────────────────────────────────
CS_BIND=127.0.0.1
CS_PORT=5566
CONSOLE_PUBLIC_HOST=localhost:5566

# ── 路径（建议都写绝对路径）────────────────────────────
# CS_DATA_DIR=/opt/cloud-shuttle/data
# CS_DOWNLOAD_ROOT=/vol2/download
# CS_STATIC=/opt/cloud-shuttle/static
# CS_RCLONE_CONFIG=/opt/cloud-shuttle/data/rclone.conf

# ── rclone ────────────────────────────────────────────
# CS_RCLONE_BIN=rclone
# auto | local | docker
CS_RCLONE_BACKEND=auto
# CS_DOCKER_CONTAINER=rclone-backend
# CS_CONTAINER_RCLONE_CONFIG=/config/rclone/rclone.conf
# CS_CONTAINER_DOWNLOAD_ROOT=/data

# ── 代理：http(s)://host:port 或 socks5://host:port，off = 直连 ──
# 设置页「自定义代理地址」优先级高于这里
PROXY_URL=http://127.0.0.1:7890

# ── 检查更新 ──────────────────────────────────────────
UPDATE_REPO=Dlany-Cohhh/cloud-shuttle-rs
